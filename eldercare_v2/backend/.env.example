# Backend Environment Configuration
# Copy this to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://eldercare_user:secure_password_here@localhost:5432/eldercare_db

# API Configuration
SECRET_KEY=your_secret_key_change_this_in_production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email Configuration (for alerts)
ALERT_EMAIL=your_email@gmail.com
ALERT_PASSWORD=your_gmail_app_password
RECIPIENT_EMAIL=caretaker@example.com

# Firebase Configuration
FIREBASE_KEY_PATH=C:/path/to/serviceAccountKey.json
FCM_DEVICE_TOKENS_FILE=C:/ElderCareProject/runtime/mobile_device_tokens.json

# AI Model Configuration
MODEL_CONFIDENCE_THRESHOLD=0.35
FALL_THRESHOLD=0.30
YOLO_WEIGHTS=yolov8n-pose.pt

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379/0

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=500
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# Logging
LOG_FILE=/app/logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Session Configuration
SESSION_TIMEOUT_MINUTES=60
JWT_EXPIRATION_HOURS=24

# Feature Flags
ENABLE_VIDEO_PROCESSING=True
ENABLE_LIVE_STREAMING=True
ENABLE_EMAIL_ALERTS=True
ENABLE_FIREBASE_ALERTS=False
ENABLE_SMS_ALERTS=False
